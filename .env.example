# --- Kalshi (read-only) -----------------------------------------------------
# From kalshi.com -> Settings -> API keys. The app only ever calls GET
# endpoints (balance, positions, settlements, fills) — it never places,
# edits or cancels an order.
KALSHI_API_KEY_ID=

# The RSA private key, either inline (newlines escaped as \n) or by path.
# Prefer the path, and keep the PEM outside the repo at mode 600.
# KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=/home/dan/.config/jarvis/kalshi-private-key.pem

# Demo environment instead of production:
# KALSHI_API_BASE=https://demo-api.kalshi.co

# Which Kalshi series count as football. Comma-separated ticker prefixes.
# KALSHI_SERIES_PREFIXES=KXNFL,KXNCAAF,KXCFB,KXSUPERBOWL

# --- App --------------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/bets.db
# BETS_DB_PATH=/opt/football-bets/data/bets.db

# Shows the amber DEV banner.
# JARVIS_ENV=dev

# If set, every write (bets, grading, syncs) needs this token as
# `Authorization: Bearer <token>` or `x-jarvis-token`. Unset = open, which is
# the right call on a tailnet-only box.
# JARVIS_TOKEN=
